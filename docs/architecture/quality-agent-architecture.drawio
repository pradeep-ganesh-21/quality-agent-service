<mxfile host="app.diagrams.net" agent="opencode" pages="2">
  <diagram name="1. High-Level Components" id="quality-agent-high-level">
    <mxGraphModel dx="1500" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontFamily=Helvetica;shadow=0;" value="Quality Agent: High-Level Components" vertex="1">
          <mxGeometry x="50" y="30" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;shadow=0;fontColor=#333333;" value="POC view. A session is one complete Quality Agent execution. A run is one completed check or command." vertex="1">
          <mxGeometry x="50" y="60" width="900" height="22" as="geometry" />
        </mxCell>
        <mxCell id="componentHeading" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontFamily=Helvetica;shadow=0;fontColor=#333333;" value="Component view" vertex="1">
          <mxGeometry x="50" y="105" width="220" height="22" as="geometry" />
        </mxCell>
        <mxCell id="agents" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=middle;fontSize=11;arcSize=8;fontColor=#333333;fontFamily=Helvetica;shadow=0;spacing=10;" value="&lt;b&gt;Existing Quality Agents&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Multiple agents call JSON hooks. Each agent creates one session, uploads completed runs, then reports the session end.&lt;/font&gt;" vertex="1">
          <mxGeometry x="50" y="175" width="300" height="285" as="geometry" />
        </mxCell>
        <mxCell id="service" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=11;arcSize=8;fontColor=#333333;fontFamily=Helvetica;shadow=0;spacing=10;" value="&lt;b&gt;Quality Agent Service&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Validates requests and performs synchronous MongoDB reads and writes. The service and MongoDB driver generate ObjectIds and return them as strings.&lt;br&gt;&lt;br&gt;Assembles session detail responses with recorded runs. No AI executes here.&lt;/font&gt;" vertex="1">
          <mxGeometry x="500" y="175" width="350" height="285" as="geometry" />
        </mxCell>
        <mxCell id="readClient" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=middle;fontSize=11;arcSize=8;fontColor=#333333;fontFamily=Helvetica;shadow=0;spacing=8;" value="&lt;b&gt;Read client&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;React in the browser, or an API client. Fetches session data from the API through NGINX. React renders the list and details.&lt;/font&gt;" vertex="1">
          <mxGeometry x="50" y="500" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="mongo" parent="1" style="swimlane;html=1;startSize=34;fillColor=#fbfbfb;strokeColor=#999999;dashed=1;fontSize=12;align=center;verticalAlign=middle;collapsible=0;fontColor=#333333;fontFamily=Helvetica;shadow=0;" value="&lt;b&gt;MongoDB&lt;/b&gt;&lt;font color=&quot;#666666&quot;&gt;&amp;nbsp; | supported POC database, two collections&lt;/font&gt;" vertex="1">
          <mxGeometry x="1000" y="120" width="440" height="500" as="geometry" />
        </mxCell>
        <mxCell id="sessions" parent="mongo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;fontFamily=Helvetica;shadow=0;spacingLeft=12;spacingRight=8;" value="&lt;b&gt;sessions&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;_id&lt;/b&gt; maps to session_id&lt;br&gt;Global metadata and configuration&lt;br&gt;started_at&lt;br&gt;completion_time is null until end is reported&lt;br&gt;invoked_by (agent-reported runner)" vertex="1">
          <mxGeometry x="35" y="65" width="370" height="145" as="geometry" />
        </mxCell>
        <mxCell id="runs" parent="mongo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;fontFamily=Helvetica;shadow=0;spacingLeft=12;spacingRight=8;" value="&lt;b&gt;runs&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;_id&lt;/b&gt; maps to run_id&lt;br&gt;&lt;b&gt;session_id&lt;/b&gt; is an ObjectId application reference&lt;br&gt;Step, command, and verdict&lt;br&gt;Evolving JSON details" vertex="1">
          <mxGeometry x="35" y="300" width="370" height="140" as="geometry" />
        </mxCell>
        <mxCell id="relation" edge="1" parent="mongo" source="sessions" target="runs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;fontColor=#333333;fontFamily=Helvetica;shadow=0;" value="1 session to many runs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="relationCaption" parent="mongo" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;shadow=0;fontColor=#666666;" value="runs.session_id → sessions._id&lt;br&gt;Application reference, not a database foreign key" vertex="1">
          <mxGeometry x="35" y="450" width="370" height="38" as="geometry" />
        </mxCell>
        <mxCell id="createSession" edge="1" parent="1" source="agents" target="service" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.18;entryX=0;entryY=0.18;endArrow=block;endFill=1;fontColor=#333333;fontFamily=Helvetica;shadow=0;" value="1. Create session">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sessionResponse" edge="1" parent="1" source="service" target="agents" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.32;entryX=1;entryY=0.32;endArrow=block;endFill=1;fontColor=#333333;fontFamily=Helvetica;shadow=0;" value="201 + session_id">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="uploadRun" edge="1" parent="1" source="agents" target="service" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.50;entryX=0;entryY=0.50;endArrow=block;endFill=1;fontColor=#333333;fontFamily=Helvetica;shadow=0;" value="2. Upload completed run">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="runResponse" edge="1" parent="1" source="service" target="agents" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.64;entryX=1;entryY=0.64;endArrow=block;endFill=1;fontColor=#333333;fontFamily=Helvetica;shadow=0;" value="201 + run_id">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="reportEnd" edge="1" parent="1" source="agents" target="service" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.82;entryX=0;entryY=0.82;endArrow=block;endFill=1;fontColor=#333333;fontFamily=Helvetica;shadow=0;" value="3. Report session end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="endResponse" edge="1" parent="1" source="service" target="agents" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.94;entryX=1;entryY=0.94;endArrow=block;endFill=1;fontColor=#333333;fontFamily=Helvetica;shadow=0;" value="200 completion">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="browseRequest" edge="1" parent="1" source="readClient" target="service" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.32;entryX=0.35;entryY=1;endArrow=block;endFill=1;fontColor=#333333;fontFamily=Helvetica;shadow=0;" value="GET via NGINX">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="420" y="538" />
              <mxPoint x="420" y="475" />
              <mxPoint x="623" y="475" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="browseResponse" edge="1" parent="1" source="service" target="readClient" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.72;exitY=1;entryX=1;entryY=0.72;endArrow=block;endFill=1;fontColor=#333333;fontFamily=Helvetica;shadow=0;" value="200 + session data">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="752" y="508" />
              <mxPoint x="460" y="508" />
              <mxPoint x="460" y="586" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="sessionWrite" edge="1" parent="1" source="service" target="sessions" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.28;entryX=0;entryY=0.45;endArrow=block;endFill=1;fontColor=#333333;fontFamily=Helvetica;shadow=0;" value="Insert session /&lt;br&gt;record session end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="runWrite" edge="1" parent="1" source="service" target="runs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.72;entryX=0;entryY=0.45;endArrow=block;endFill=1;fontColor=#333333;fontFamily=Helvetica;shadow=0;" value="Insert run">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mongoRead" edge="1" parent="1" source="mongo" target="service" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.94;entryX=1;entryY=0.94;endArrow=block;endFill=1;fontColor=#333333;fontFamily=Helvetica;shadow=0;" value="Read results">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="970" y="590" />
              <mxPoint x="970" y="510" />
              <mxPoint x="900" y="510" />
              <mxPoint x="900" y="443" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="note" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffcc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontSize=11;fontColor=#333333;fontFamily=Helvetica;shadow=0;" value="&lt;b&gt;Message order and retry caveat&lt;/b&gt;&lt;br&gt;The agent waits for session_id before uploading runs, then reports the end after uploads. Service-generated IDs do not deduplicate a create retry after a lost response." vertex="1">
          <mxGeometry x="500" y="530" width="440" height="90" as="geometry" />
        </mxCell>
        <mxCell id="endpointHeading" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontFamily=Helvetica;shadow=0;fontColor=#333333;" value="Proposed REST endpoints" vertex="1">
          <mxGeometry x="50" y="660" width="220" height="22" as="geometry" />
        </mxCell>
        <mxCell id="agentEndpoints" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;fontFamily=Helvetica;shadow=0;spacingTop=10;spacingLeft=12;spacingRight=10;" value="&lt;b&gt;Agents write&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;POST /v1/sessions&lt;/b&gt;&amp;nbsp; | 201 + session_id&lt;br&gt;&lt;b&gt;POST /v1/sessions/{session_id}/runs&lt;/b&gt;&amp;nbsp; | 201 + run_id&lt;br&gt;&lt;b&gt;PATCH /v1/sessions/{session_id}&lt;/b&gt;&amp;nbsp; | report session end; 200" vertex="1">
          <mxGeometry x="50" y="690" width="720" height="145" as="geometry" />
        </mxCell>
        <mxCell id="readEndpoints" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;fontFamily=Helvetica;shadow=0;spacingTop=10;spacingLeft=12;spacingRight=10;" value="&lt;b&gt;Clients browse&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;GET /v1/sessions&lt;/b&gt;&amp;nbsp; | root fields only; 200&lt;br&gt;&lt;b&gt;GET /v1/sessions/{session_id}&lt;/b&gt;&amp;nbsp; | metadata + runs included; 200&lt;br&gt;&lt;br&gt;List responses omit metadata and runs." vertex="1">
          <mxGeometry x="790" y="690" width="650" height="145" as="geometry" />
        </mxCell>
        <mxCell id="writeRule" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontFamily=Helvetica;shadow=0;fontColor=#555555;whiteSpace=wrap;" value="Responses are sent after the MongoDB operation is acknowledged. The end update changes the session only, not its run documents." vertex="1">
          <mxGeometry x="50" y="850" width="1390" height="38" as="geometry" />
        </mxCell>
        <mxCell id="footer" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontFamily=Helvetica;shadow=0;fontColor=#555555;whiteSpace=wrap;" value="POC constraints: low volume, no queue or orchestration. NGINX enforces authentication; the mechanism is unspecified. See page 2. If completion is not received, the session end is not reported. That silence is not proof that the agent is still running." vertex="1">
          <mxGeometry x="50" y="915" width="1390" height="42" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="2. Deployment Architecture and Flows" id="quality-agent-deployment-flows">
    <mxGraphModel dx="2335" dy="1466" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="q2-root" />
        <mxCell id="q2-layer" parent="q2-root" />
        <mxCell id="q2-title" parent="q2-layer" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontFamily=Helvetica;shadow=0;" value="Quality Agent: Deployment Architecture and Flows" vertex="1">
          <mxGeometry height="34" width="1100" x="60" y="30" as="geometry" />
        </mxCell>
        <mxCell id="q2-subtitle" parent="q2-layer" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;shadow=0;fontColor=#555555;" value="Proposed architecture. One Docker Compose host runs exactly one NGINX, API server, web server, and MongoDB container." vertex="1">
          <mxGeometry height="24" width="1500" x="60" y="62" as="geometry" />
        </mxCell>
        <mxCell id="q2-legend" parent="q2-layer" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontFamily=Helvetica;shadow=0;fontColor=#333333;" value="&lt;b&gt;Flows:&lt;/b&gt;&amp;nbsp; &lt;font color=&quot;#1a73e8&quot;&gt;1 Create session&lt;/font&gt;&amp;nbsp;&amp;nbsp; | &amp;nbsp;&lt;font color=&quot;#2e7d32&quot;&gt;2 Upload run&lt;/font&gt;&amp;nbsp;&amp;nbsp; | &amp;nbsp;&lt;font color=&quot;#d97706&quot;&gt;3 Complete session&lt;/font&gt;&amp;nbsp;&amp;nbsp; | &amp;nbsp;&lt;font color=&quot;#7e57c2&quot;&gt;4 UI&lt;/font&gt;&amp;nbsp;&amp;nbsp; | &amp;nbsp;Solid: request&amp;nbsp;&amp;nbsp; Dashed: response" vertex="1">
          <mxGeometry height="28" width="2050" x="60" y="90" as="geometry" />
        </mxCell>
        <mxCell id="q2-network" parent="q2-layer" style="swimlane;html=1;startSize=40;fillColor=#fbfbfb;strokeColor=#999999;fontSize=14;fontStyle=1;align=left;spacingLeft=14;verticalAlign=middle;collapsible=0;fontColor=#333333;fontFamily=Helvetica;shadow=0;" value="Docker Compose host | shared Docker network" vertex="1">
          <mxGeometry height="870" width="1780" x="450" y="140" as="geometry" />
        </mxCell>
        <mxCell id="q2-agent" parent="q2-layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=middle;fontSize=14;arcSize=8;fontColor=#333333;fontFamily=Helvetica;shadow=0;spacing=12;" value="&lt;b&gt;Quality agent&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Outside Docker&lt;br&gt;&lt;br&gt;Creates a session at start.&lt;br&gt;Uploads completed runs.&lt;br&gt;Reports completion after all run uploads are acknowledged.&lt;/font&gt;" vertex="1">
          <mxGeometry height="410" width="260" x="60" y="190" as="geometry" />
        </mxCell>
        <mxCell id="q2-browser" parent="q2-layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=middle;fontSize=14;arcSize=8;fontColor=#333333;fontFamily=Helvetica;shadow=0;spacing=10;" value="&lt;b&gt;Browser actor&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Outside Docker&lt;br&gt;Runs React and fetches API data through NGINX.&lt;br&gt;Renders session lists and details.&lt;/font&gt;" vertex="1">
          <mxGeometry height="330" width="260" x="60" y="620" as="geometry" />
        </mxCell>
        <mxCell id="q2-nginx" parent="q2-layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;fontSize=14;arcSize=6;fontColor=#333333;fontFamily=Helvetica;shadow=0;spacing=12;" value="&lt;b&gt;NGINX container&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Only externally exposed entry&lt;br&gt;Terminates HTTPS&lt;br&gt;Enforces authentication&lt;br&gt;Provider and mechanism unspecified&lt;br&gt;&lt;br&gt;&lt;b&gt;/v1/*&lt;/b&gt; → API server&lt;br&gt;Remaining UI routes → web server&lt;/font&gt;" vertex="1">
          <mxGeometry height="760" width="200" x="500" y="190" as="geometry" />
        </mxCell>
        <mxCell id="q2-api" parent="q2-layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=14;arcSize=8;fontColor=#333333;fontFamily=Helvetica;shadow=0;spacing=12;" value="&lt;b&gt;API server container&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Five /v1 endpoints&lt;br&gt;Validates requests&lt;br&gt;Reads and writes MongoDB synchronously&lt;br&gt;Stores agent-supplied completion data&lt;br&gt;Returns string IDs after acknowledged inserts&lt;br&gt;&lt;br&gt;No published external port&lt;/font&gt;" vertex="1">
          <mxGeometry height="550" width="440" x="960" y="190" as="geometry" />
        </mxCell>
        <mxCell id="q2-mongo" parent="q2-layer" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=14;fontColor=#333333;fontFamily=Helvetica;shadow=0;spacing=12;" value="&lt;b&gt;MongoDB container&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;&lt;b&gt;sessions&lt;/b&gt;&lt;br&gt;Session state and completion data&lt;br&gt;&lt;br&gt;&lt;b&gt;runs&lt;/b&gt;&lt;br&gt;Many completed check documents per session&lt;br&gt;runs.session_id references sessions._id&lt;br&gt;Application reference, not a MongoDB foreign key&lt;br&gt;&lt;br&gt;No published external port&lt;/font&gt;" vertex="1">
          <mxGeometry height="550" width="450" x="1720" y="190" as="geometry" />
        </mxCell>
        <mxCell id="q2-web" parent="q2-layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=14;arcSize=8;fontColor=#333333;fontFamily=Helvetica;shadow=0;spacing=10;" value="&lt;b&gt;Web server container&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Serves built React HTML, JavaScript, and CSS.&lt;br&gt;No API or MongoDB calls. No BFF.&lt;br&gt;No published external port.&lt;/font&gt;" vertex="1">
          <mxGeometry height="150" width="440" x="960" y="800" as="geometry" />
        </mxCell>
        <mxCell id="q2-volume" parent="q2-layer" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=center;verticalAlign=middle;fontSize=14;fontColor=#333333;fontFamily=Helvetica;shadow=0;" value="&lt;b&gt;Named volume&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Persistent MongoDB storage&lt;br&gt;Storage, not a container&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="330" x="1780" y="830" as="geometry" />
        </mxCell>
        <mxCell id="q2-card-flow1" parent="q2-layer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7fbff;strokeColor=#1a73e8;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=13;fontColor=#333333;fontFamily=Helvetica;shadow=0;" value="&lt;b&gt;&lt;font color=&quot;#1a73e8&quot;&gt;Flow 1: create a session&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;POST /v1/sessions&lt;/b&gt;&lt;br&gt;&lt;br&gt;The quality agent requests session creation. The API validates the request and sets the initial state to &lt;b&gt;IN_PROGRESS&lt;/b&gt; with &lt;b&gt;completion_time: null&lt;/b&gt;.&lt;br&gt;&lt;br&gt;MongoDB and its driver generate sessions._id. After the insert is acknowledged, the ID is serialized as a string.&lt;br&gt;&lt;br&gt;&lt;b&gt;Response:&lt;/b&gt; 201 + session_id through NGINX." vertex="1">
          <mxGeometry height="330" width="500" x="60" y="1070" as="geometry" />
        </mxCell>
        <mxCell id="q2-card-flow2" parent="q2-layer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f6fbf6;strokeColor=#2e7d32;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=13;fontColor=#333333;fontFamily=Helvetica;shadow=0;" value="&lt;b&gt;&lt;font color=&quot;#2e7d32&quot;&gt;Flow 2: upload a completed run&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;POST /v1/sessions/{session_id}/runs&lt;/b&gt;&lt;br&gt;&lt;br&gt;Each request inserts one completed check document. The run references its session. A session can have many run documents.&lt;br&gt;&lt;br&gt;MongoDB and its driver generate runs._id. After the insert is acknowledged, the ID is serialized as a string.&lt;br&gt;&lt;br&gt;&lt;b&gt;Response:&lt;/b&gt; 201 + run_id through NGINX." vertex="1">
          <mxGeometry height="330" width="500" x="620" y="1070" as="geometry" />
        </mxCell>
        <mxCell id="q2-card-flow3" parent="q2-layer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8ee;strokeColor=#d97706;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=13;fontColor=#333333;fontFamily=Helvetica;shadow=0;" value="&lt;b&gt;&lt;font color=&quot;#d97706&quot;&gt;Flow 3: report completion&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PATCH /v1/sessions/{session_id}&lt;/b&gt;&lt;br&gt;&lt;br&gt;After all run uploads are acknowledged, the agent supplies completion_time, status &lt;b&gt;COMPLETED&lt;/b&gt; or &lt;b&gt;FAILED&lt;/b&gt;, and last_step_executed as an array of RunIDs.&lt;br&gt;&lt;br&gt;execution_outcome contains defect_count, gap_count, and contract_ingredient_count. These are session-wide counts supplied by the agent. The API stores them. It does not compute or aggregate them.&lt;br&gt;&lt;br&gt;Only the session document is updated. &lt;b&gt;Response:&lt;/b&gt; 200 through NGINX." vertex="1">
          <mxGeometry height="330" width="500" x="1180" y="1070" as="geometry" />
        </mxCell>
        <mxCell id="q2-card-flow4" parent="q2-layer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#faf7ff;strokeColor=#7e57c2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=13;fontColor=#333333;fontFamily=Helvetica;shadow=0;" value="&lt;b&gt;&lt;font color=&quot;#7e57c2&quot;&gt;Flow 4: load and use the UI&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;4a Load React assets&lt;/b&gt;&lt;br&gt;The browser loads HTML, JavaScript, and CSS through NGINX from the web server.&lt;br&gt;&lt;br&gt;&lt;b&gt;4b Fetch session data&lt;/b&gt;&lt;br&gt;React calls relative &lt;b&gt;GET /v1/sessions&lt;/b&gt; or &lt;b&gt;GET /v1/sessions/{session_id}&lt;/b&gt;. NGINX routes these requests to the API, which queries MongoDB. JSON returns through NGINX to the browser, where React renders it.&lt;br&gt;&lt;br&gt;The list returns eight root fields only, without metadata or runs. Detail includes metadata and runs.&lt;br&gt;&lt;br&gt;The web server serves assets only. It does not call the API or MongoDB." vertex="1">
          <mxGeometry height="330" width="490" x="1740" y="1070" as="geometry" />
        </mxCell>
        <mxCell id="q2-caveat" parent="q2-layer" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontFamily=Helvetica;shadow=0;fontColor=#555555;whiteSpace=wrap;" value="Write success responses follow MongoDB acknowledgement. API reads return query results; UI assets come from the web server. A lost POST response may cause a duplicate when the caller retries." vertex="1">
          <mxGeometry height="35" width="2170" x="60" y="1425" as="geometry" />
        </mxCell>
        <mxCell id="q2-f1-agent-nginx-req" edge="1" parent="q2-layer" source="q2-agent" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#1a73e8;strokeWidth=2;exitX=1;exitY=0.146;entryX=0;entryY=0.079;endArrow=block;endFill=1;fontColor=#1a73e8;fontFamily=Helvetica;shadow=0;" target="q2-nginx" value="1a POST create session">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="q2-f1-nginx-api-req" edge="1" parent="q2-layer" source="q2-nginx" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#1a73e8;strokeWidth=2;exitX=1;exitY=0.079;entryX=0;entryY=0.109;endArrow=block;endFill=1;fontColor=#1a73e8;fontFamily=Helvetica;shadow=0;" target="q2-api" value="1b route /v1/*">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
