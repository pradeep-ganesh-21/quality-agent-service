<mxfile host="app.diagrams.net" agent="opencode" pages="2">
  <diagram name="1. High-Level Components" id="quality-agent-high-level">
    <mxGraphModel dx="1500" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontFamily=Helvetica;shadow=0;" value="Quality Agent: High-Level Components" vertex="1">
          <mxGeometry x="50" y="30" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;shadow=0;fontColor=#333333;" value="POC view. A session is one Quality Agent execution; a run is one completed check or command. Planned flows are specified but not yet implemented." vertex="1">
          <mxGeometry x="50" y="60" width="1390" height="22" as="geometry" />
        </mxCell>
        <mxCell id="componentHeading" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontFamily=Helvetica;shadow=0;fontColor=#333333;" value="Component view" vertex="1">
          <mxGeometry x="50" y="105" width="220" height="22" as="geometry" />
        </mxCell>
        <mxCell id="agents" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=middle;fontSize=11;arcSize=8;fontColor=#333333;fontFamily=Helvetica;shadow=0;spacing=10;" value="&lt;b&gt;Existing Quality Agents&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Create a session and send partial progress or terminal updates while it is open.&lt;br&gt;&lt;br&gt;Uploading completed runs is planned; that endpoint is not yet implemented.&lt;/font&gt;" vertex="1">
          <mxGeometry x="50" y="175" width="300" height="285" as="geometry" />
        </mxCell>
        <mxCell id="service" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=11;arcSize=8;fontColor=#333333;fontFamily=Helvetica;shadow=0;spacing=10;" value="&lt;b&gt;Quality Agent Service&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Validates requests. Uses PyMongo Async for MongoDB reads and writes within each HTTP request. Repositories generate ObjectIds and return string IDs.&lt;br&gt;&lt;br&gt;Returns filtered, cursor-paginated session lists. Reads session detail and runs separately, without a snapshot.&lt;br&gt;&lt;br&gt;No AI executes here.&lt;/font&gt;" vertex="1">
          <mxGeometry x="500" y="175" width="350" height="285" as="geometry" />
        </mxCell>
        <mxCell id="readClient" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=middle;fontSize=11;arcSize=8;fontColor=#333333;fontFamily=Helvetica;shadow=0;spacing=8;" value="&lt;b&gt;Read client&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;React in the browser, or an API client. Fetches session data from the API through NGINX. React renders the list and details.&lt;/font&gt;" vertex="1">
          <mxGeometry x="50" y="500" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="mongo" parent="1" style="swimlane;html=1;startSize=34;fillColor=#fbfbfb;strokeColor=#999999;dashed=1;fontSize=12;align=center;verticalAlign=middle;collapsible=0;fontColor=#333333;fontFamily=Helvetica;shadow=0;" value="&lt;b&gt;MongoDB&lt;/b&gt;&lt;font color=&quot;#666666&quot;&gt;&amp;nbsp; | supported POC database, two collections&lt;/font&gt;" vertex="1">
          <mxGeometry x="1000" y="120" width="440" height="580" as="geometry" />
        </mxCell>
        <mxCell id="sessions" parent="mongo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;fontFamily=Helvetica;shadow=0;spacingLeft=12;spacingRight=8;" value="&lt;b&gt;sessions&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;_id&lt;/b&gt; maps to session_id&lt;br&gt;schema_version: 1&lt;br&gt;started_at: creation-only&lt;br&gt;received_at: server-generated&lt;br&gt;status: IN_PROGRESS, COMPLETED, or FAILED&lt;br&gt;completion_time: nullable, even when terminal&lt;br&gt;last_step_executed: step display names&lt;br&gt;execution_outcome: object or null&lt;br&gt;metadata: preserved extra JSON&lt;br&gt;metadata.invoked_by: unverified extra&lt;br&gt;metadata.recorded_by: unverified extra" vertex="1">
          <mxGeometry x="35" y="65" width="370" height="205" as="geometry" />
        </mxCell>
        <mxCell id="runs" parent="mongo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;fontFamily=Helvetica;shadow=0;spacingLeft=12;spacingRight=8;" value="&lt;b&gt;runs&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;_id&lt;/b&gt; maps to run_id&lt;br&gt;&lt;b&gt;session_id&lt;/b&gt; is an ObjectId application reference&lt;br&gt;schema_version: 1&lt;br&gt;step, command, verdict&lt;br&gt;occurred_at: run timestamp&lt;br&gt;received_at: server-generated&lt;br&gt;details: preserved extra JSON&lt;br&gt;Planned upload accepts at as an input alias only." vertex="1">
          <mxGeometry x="35" y="300" width="370" height="185" as="geometry" />
        </mxCell>
        <mxCell id="relation" edge="1" parent="mongo" source="sessions" target="runs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;fontColor=#333333;fontFamily=Helvetica;shadow=0;" value="1 session to many runs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="relationCaption" parent="mongo" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;fontFamily=Helvetica;shadow=0;fontColor=#666666;" value="runs.session_id → sessions._id&lt;br&gt;Application reference, not a database foreign key" vertex="1">
          <mxGeometry x="35" y="500" width="370" height="38" as="geometry" />
        </mxCell>
        <mxCell id="createSession" edge="1" parent="1" source="agents" target="service" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.18;entryX=0;entryY=0.18;endArrow=block;endFill=1;fontColor=#333333;fontFamily=Helvetica;shadow=0;" value="1. Create session">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sessionResponse" edge="1" parent="1" source="service" target="agents" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.32;entryX=1;entryY=0.32;endArrow=block;endFill=1;fontColor=#333333;fontFamily=Helvetica;shadow=0;" value="201 + session_id">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="uploadRun" edge="1" parent="1" source="agents" target="service" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.50;entryX=0;entryY=0.50;endArrow=block;endFill=1;fontColor=#333333;fontFamily=Helvetica;shadow=0;" value="2. Upload run&lt;br&gt;(planned)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="runResponse" edge="1" parent="1" source="service" target="agents" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.64;entryX=1;entryY=0.64;endArrow=block;endFill=1;fontColor=#333333;fontFamily=Helvetica;shadow=0;" value="201 + run_id&lt;br&gt;(planned)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="reportEnd" edge="1" parent="1" source="agents" target="service" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.82;entryX=0;entryY=0.82;endArrow=block;endFill=1;fontColor=#333333;fontFamily=Helvetica;shadow=0;" value="3. PATCH session">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="endResponse" edge="1" parent="1" source="service" target="agents" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.94;entryX=1;entryY=0.94;endArrow=block;endFill=1;fontColor=#333333;fontFamily=Helvetica;shadow=0;" value="200 + session_id">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="browseRequest" edge="1" parent="1" source="readClient" target="service" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.32;entryX=0.35;entryY=1;endArrow=block;endFill=1;fontColor=#333333;fontFamily=Helvetica;shadow=0;" value="GET via NGINX">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="420" y="538" />
              <mxPoint x="420" y="475" />
              <mxPoint x="623" y="475" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="browseResponse" edge="1" parent="1" source="service" target="readClient" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.72;exitY=1;entryX=1;entryY=0.72;endArrow=block;endFill=1;fontColor=#333333;fontFamily=Helvetica;shadow=0;" value="200 + page or detail">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="752" y="508" />
              <mxPoint x="460" y="508" />
              <mxPoint x="460" y="586" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="sessionWrite" edge="1" parent="1" source="service" target="sessions" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.28;entryX=0;entryY=0.45;endArrow=block;endFill=1;fontColor=#333333;fontFamily=Helvetica;shadow=0;" value="Insert session /&lt;br&gt;guarded partial update">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="runWrite" edge="1" parent="1" source="service" target="runs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.72;entryX=0;entryY=0.45;endArrow=block;endFill=1;fontColor=#333333;fontFamily=Helvetica;shadow=0;" value="Insert run (planned)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mongoRead" edge="1" parent="1" source="mongo" target="service" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.94;entryX=1;entryY=0.94;endArrow=block;endFill=1;fontColor=#333333;fontFamily=Helvetica;shadow=0;" value="Read results">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="970" y="665" />
              <mxPoint x="970" y="510" />
              <mxPoint x="900" y="510" />
              <mxPoint x="900" y="443" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="note" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffcc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontSize=11;fontColor=#333333;fontFamily=Helvetica;shadow=0;" value="&lt;b&gt;Planned upload order and retry caveat&lt;/b&gt;&lt;br&gt;Run upload will require session_id. Agents should upload runs before closing, but late runs remain allowed by the contract. Retrying a create after a lost response can create a duplicate." vertex="1">
          <mxGeometry x="500" y="530" width="440" height="90" as="geometry" />
        </mxCell>
        <mxCell id="endpointHeading" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontFamily=Helvetica;shadow=0;fontColor=#333333;" value="REST endpoints" vertex="1">
          <mxGeometry x="50" y="730" width="220" height="22" as="geometry" />
        </mxCell>
        <mxCell id="agentEndpoints" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;fontFamily=Helvetica;shadow=0;spacingTop=10;spacingLeft=12;spacingRight=10;" value="&lt;b&gt;Agents write&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;POST /v1/sessions&lt;/b&gt; | 201 + session_id&lt;br&gt;Requires started_at. Creates an IN_PROGRESS session.&lt;br&gt;&lt;br&gt;&lt;b&gt;POST /v1/sessions/{session_id}/runs&lt;/b&gt; | planned, not yet implemented&lt;br&gt;Specified response: 201 + run_id. Inserts one run; terminal parents are allowed.&lt;br&gt;&lt;br&gt;&lt;b&gt;PATCH /v1/sessions/{session_id}&lt;/b&gt; | 200 + session_id&lt;br&gt;Open partial update, not completion-only. Stored status must be IN_PROGRESS.&lt;br&gt;A valid patch to a terminal session returns 409 session_not_open.&lt;br&gt;Root started_at is creation-only: supplying it returns 400 forbidden_field&lt;br&gt;after raw JSON checks. The entire patch is rejected.&lt;br&gt;last_step_executed contains step display names, not run IDs.&lt;br&gt;Omitted fields stay unchanged; extra fields shallow-merge into metadata." vertex="1">
          <mxGeometry x="50" y="760" width="720" height="270" as="geometry" />
        </mxCell>
        <mxCell id="readEndpoints" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;fontFamily=Helvetica;shadow=0;spacingTop=10;spacingLeft=12;spacingRight=10;" value="&lt;b&gt;Clients browse&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;GET /v1/sessions&lt;/b&gt; | 200, paginated envelope, not a bare array&lt;br&gt;Envelope: items, page_size, total_count, next_cursor, previous_cursor&lt;br&gt;Query: fields (repeatable), status, started_from, started_before,&lt;br&gt;boundary, invoked_by_email, page_size, cursor&lt;br&gt;page_size: 1 through 100, default 25. Next and previous cursors only.&lt;br&gt;Unknown, invalid, or repeated scalar parameters: 400 invalid_field.&lt;br&gt;Default items: eight root fields, excluding metadata and runs.&lt;br&gt;fields selects allowed roots or paths under metadata or execution_outcome.&lt;br&gt;session_id always returns; runs is never selectable.&lt;br&gt;Counts and pages are live, not a snapshot.&lt;br&gt;&lt;br&gt;&lt;b&gt;GET /v1/sessions/{session_id}&lt;/b&gt; | 200, full metadata + runs&lt;br&gt;No field selection or pagination. Two reads, no snapshot or hidden run limit.&lt;br&gt;Unknown or malformed session ID: 404 session_not_found." vertex="1">
          <mxGeometry x="790" y="760" width="650" height="270" as="geometry" />
        </mxCell>
        <mxCell id="writeRule" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontFamily=Helvetica;shadow=0;fontColor=#555555;whiteSpace=wrap;" value="Write success responses follow MongoDB acknowledgement. PATCH changes the session only, not its run documents.&lt;br&gt;Full request, response, filter, and cursor rules: &lt;a href=&quot;https://hyland.atlassian.net/wiki/spaces/~712020240b4655f2f94280b58c2de40b6148a7/pages/4341235845/API+Documentation&quot;&gt;API Documentation&lt;/a&gt;. DESIGN.md remains the authoritative contract." vertex="1">
          <mxGeometry x="50" y="1045" width="1390" height="38" as="geometry" />
        </mxCell>
        <mxCell id="footer" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontFamily=Helvetica;shadow=0;fontColor=#555555;whiteSpace=wrap;" value="POC: HTTP only on host port 8080, no TLS or HTTP authentication. Any host that can reach NGINX can read and write /v1/*. No queue or orchestration.&lt;br&gt;Production direction only: HTTPS and authenticated agents are outside this POC. See page 2 for the implemented routing.&lt;br&gt;Missing completion is not proof that the agent is still running." vertex="1">
          <mxGeometry x="50" y="1100" width="1390" height="62" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="2. Deployment Architecture and Flows" id="quality-agent-deployment-flows">
    <mxGraphModel dx="2335" dy="1466" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="1660" math="0" shadow="0">
      <root>
        <mxCell id="q2-root" />
        <mxCell id="q2-layer" parent="q2-root" />
        <mxCell id="q2-title" parent="q2-layer" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontFamily=Helvetica;shadow=0;" value="Quality Agent: Deployment Architecture and Flows" vertex="1">
          <mxGeometry height="34" width="1100" x="60" y="30" as="geometry" />
        </mxCell>
        <mxCell id="q2-subtitle" parent="q2-layer" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;shadow=0;fontColor=#555555;" value="Implemented POC topology: one Docker Compose host with NGINX, API, web, and MongoDB containers. Run upload is planned, not yet implemented." vertex="1">
          <mxGeometry height="24" width="2050" x="60" y="66" as="geometry" />
        </mxCell>
        <mxCell id="q2-legend" parent="q2-layer" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontFamily=Helvetica;shadow=0;fontColor=#333333;" value="&lt;b&gt;Flows:&lt;/b&gt;&amp;nbsp; &lt;font color=&quot;#1a73e8&quot;&gt;1 Create session&lt;/font&gt;&amp;nbsp;&amp;nbsp; | &amp;nbsp;&lt;font color=&quot;#2e7d32&quot;&gt;2 Upload run (planned)&lt;/font&gt;&amp;nbsp;&amp;nbsp; | &amp;nbsp;&lt;font color=&quot;#d97706&quot;&gt;3 Patch open session&lt;/font&gt;&amp;nbsp;&amp;nbsp; | &amp;nbsp;&lt;font color=&quot;#7e57c2&quot;&gt;4 UI&lt;/font&gt;&amp;nbsp;&amp;nbsp; | &amp;nbsp;Solid: request&amp;nbsp;&amp;nbsp; Dashed: response" vertex="1">
          <mxGeometry height="28" width="2050" x="60" y="90" as="geometry" />
        </mxCell>
        <mxCell id="q2-network" parent="q2-layer" style="swimlane;html=1;startSize=40;fillColor=#fbfbfb;strokeColor=#999999;fontSize=14;fontStyle=1;align=left;spacingLeft=14;verticalAlign=middle;collapsible=0;fontColor=#333333;fontFamily=Helvetica;shadow=0;" value="Docker Compose host | shared Docker network" vertex="1">
          <mxGeometry height="870" width="1780" x="450" y="140" as="geometry" />
        </mxCell>
        <mxCell id="q2-agent" parent="q2-layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=middle;fontSize=14;arcSize=8;fontColor=#333333;fontFamily=Helvetica;shadow=0;spacing=12;" value="&lt;b&gt;Quality agent&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Outside Docker&lt;br&gt;&lt;br&gt;Creates a session.&lt;br&gt;Sends progress or terminal patches while it is open.&lt;br&gt;&lt;br&gt;Run upload is planned.&lt;br&gt;The intended order is to upload runs before closing the session.&lt;/font&gt;" vertex="1">
          <mxGeometry height="410" width="260" x="60" y="190" as="geometry" />
        </mxCell>
        <mxCell id="q2-browser" parent="q2-layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=middle;fontSize=14;arcSize=8;fontColor=#333333;fontFamily=Helvetica;shadow=0;spacing=10;" value="&lt;b&gt;Browser actor&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Outside Docker&lt;br&gt;Runs React and fetches API data through NGINX.&lt;br&gt;Renders session lists and details.&lt;/font&gt;" vertex="1">
          <mxGeometry height="330" width="260" x="60" y="620" as="geometry" />
        </mxCell>
        <mxCell id="q2-nginx" parent="q2-layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;fontSize=14;arcSize=6;fontColor=#333333;fontFamily=Helvetica;shadow=0;spacing=12;" value="&lt;b&gt;NGINX container&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Only host-published entry&lt;br&gt;0.0.0.0:8080 → port 80&lt;br&gt;HTTP only&lt;br&gt;No TLS or HTTP authentication&lt;br&gt;&lt;br&gt;&lt;b&gt;/v1/*&lt;/b&gt; → API:8000&lt;br&gt;Other paths → web:8080&lt;br&gt;&lt;br&gt;Edge &lt;b&gt;/healthz&lt;/b&gt; → 404&lt;br&gt;No request body size cap&lt;/font&gt;" vertex="1">
          <mxGeometry height="760" width="200" x="500" y="190" as="geometry" />
        </mxCell>
        <mxCell id="q2-api" parent="q2-layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=14;arcSize=8;fontColor=#333333;fontFamily=Helvetica;shadow=0;spacing=12;" value="&lt;b&gt;API server container&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Four implemented /v1 routes&lt;br&gt;GET / POST /v1/sessions&lt;br&gt;GET / PATCH /v1/sessions/{session_id}&lt;br&gt;Fifth route, POST runs: planned&lt;br&gt;&lt;br&gt;Validates requests; uses PyMongo Async&lt;br&gt;Filtered lists with cursor pagination&lt;br&gt;Guarded partial updates of open sessions&lt;br&gt;Returns string IDs after acknowledged inserts&lt;br&gt;&lt;br&gt;Internal GET /healthz: liveness only&lt;br&gt;No published external port&lt;/font&gt;" vertex="1">
          <mxGeometry height="550" width="440" x="960" y="190" as="geometry" />
        </mxCell>
        <mxCell id="q2-mongo" parent="q2-layer" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=14;fontColor=#333333;fontFamily=Helvetica;shadow=0;spacing=12;" value="&lt;b&gt;MongoDB container&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;&lt;b&gt;sessions&lt;/b&gt;&lt;br&gt;Session state and completion data&lt;br&gt;&lt;br&gt;&lt;b&gt;runs&lt;/b&gt;&lt;br&gt;Many completed check documents per session&lt;br&gt;runs.session_id references sessions._id&lt;br&gt;Application reference, not a MongoDB foreign key&lt;br&gt;&lt;br&gt;No published external port&lt;/font&gt;" vertex="1">
          <mxGeometry height="550" width="450" x="1720" y="190" as="geometry" />
        </mxCell>
        <mxCell id="q2-web" parent="q2-layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=14;arcSize=8;fontColor=#333333;fontFamily=Helvetica;shadow=0;spacing=10;" value="&lt;b&gt;Web server container&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;SPA: / and /sessions/{session_id}&lt;br&gt;Built React assets: /assets/*&lt;br&gt;Unknown routes or missing assets: 404&lt;br&gt;Internal /healthz: liveness only&lt;br&gt;No API or MongoDB calls. No BFF.&lt;br&gt;No published external port.&lt;/font&gt;" vertex="1">
          <mxGeometry height="150" width="440" x="960" y="800" as="geometry" />
        </mxCell>
        <mxCell id="q2-volume" parent="q2-layer" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=center;verticalAlign=middle;fontSize=14;fontColor=#333333;fontFamily=Helvetica;shadow=0;" value="&lt;b&gt;Named volume&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Persistent MongoDB storage&lt;br&gt;Storage, not a container&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="330" x="1780" y="830" as="geometry" />
        </mxCell>
        <mxCell id="q2-card-flow1" parent="q2-layer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7fbff;strokeColor=#1a73e8;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=13;fontColor=#333333;fontFamily=Helvetica;shadow=0;" value="&lt;b&gt;&lt;font color=&quot;#1a73e8&quot;&gt;Flow 1: create a session&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;POST /v1/sessions&lt;/b&gt;&lt;br&gt;&lt;br&gt;Requires started_at as a timestamp with a timezone. This root field is creation-only. Extra request fields are preserved under metadata.&lt;br&gt;&lt;br&gt;Initial state: status IN_PROGRESS, completion_time null, last_step_executed [], execution_outcome null. The server sets received_at and schema_version: 1.&lt;br&gt;&lt;br&gt;The repository generates sessions._id as an ObjectId. After the insert is acknowledged, the ID is returned as a string.&lt;br&gt;&lt;br&gt;&lt;b&gt;Response:&lt;/b&gt; 201 + session_id through NGINX.&lt;br&gt;No idempotency or create-retry deduplication." vertex="1">
          <mxGeometry height="470" width="500" x="60" y="1070" as="geometry" />
        </mxCell>
        <mxCell id="q2-card-flow2" parent="q2-layer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f6fbf6;strokeColor=#2e7d32;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=13;fontColor=#333333;fontFamily=Helvetica;shadow=0;" value="&lt;b&gt;&lt;font color=&quot;#2e7d32&quot;&gt;Flow 2: upload a completed run (planned)&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;POST /v1/sessions/{session_id}/runs&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Not yet implemented.&lt;/b&gt; Specified in DESIGN.md section 7; the route is not registered.&lt;br&gt;&lt;br&gt;Planned behavior: insert one run for an existing session, including a terminal session. The parent ID comes from the URL.&lt;br&gt;&lt;br&gt;Requires step, command, verdict, and exactly one timestamp: at or occurred_at. Stores the timestamp as occurred_at and extras under details.&lt;br&gt;&lt;br&gt;The repository generates runs._id as an ObjectId.&lt;br&gt;&lt;b&gt;Specified response:&lt;/b&gt; 201 + run_id after the insert is acknowledged, through NGINX.&lt;br&gt;&lt;br&gt;No transaction or frozen run set on session completion." vertex="1">
          <mxGeometry height="470" width="500" x="620" y="1070" as="geometry" />
        </mxCell>
        <mxCell id="q2-card-flow3" parent="q2-layer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8ee;strokeColor=#d97706;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=13;fontColor=#333333;fontFamily=Helvetica;shadow=0;" value="&lt;b&gt;&lt;font color=&quot;#d97706&quot;&gt;Flow 3: patch an open session&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PATCH /v1/sessions/{session_id}&lt;/b&gt;&lt;br&gt;&lt;br&gt;Partial progress or terminal update. All fields are optional; omitted fields stay unchanged. Extra fields shallow-merge into metadata.&lt;br&gt;&lt;br&gt;Stored status must be IN_PROGRESS. Any valid patch to a terminal session returns 409 session_not_open.&lt;br&gt;A supplied status must be COMPLETED or FAILED. A status-only patch is valid; no automatic completion_time.&lt;br&gt;&lt;br&gt;Root started_at is creation-only. After raw JSON checks, any occurrence rejects the entire patch with 400 forbidden_field.&lt;br&gt;&lt;br&gt;last_step_executed replaces the list of step display names, not run IDs. execution_outcome replaces the object or becomes null. Optional counts: defect_count, gap_count, contract_ingredient_count. Counts are supplied, never computed.&lt;br&gt;&lt;br&gt;Atomic status guard and session-only update.&lt;br&gt;&lt;b&gt;Response:&lt;/b&gt; 200 + session_id through NGINX." vertex="1">
          <mxGeometry height="470" width="500" x="1180" y="1070" as="geometry" />
        </mxCell>
        <mxCell id="q2-card-flow4" parent="q2-layer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#faf7ff;strokeColor=#7e57c2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=13;fontColor=#333333;fontFamily=Helvetica;shadow=0;" value="&lt;b&gt;&lt;font color=&quot;#7e57c2&quot;&gt;Flow 4: load and use the UI&lt;/font&gt;&lt;/b&gt;&lt;hr&gt;&lt;b&gt;4a Load React assets&lt;/b&gt;&lt;br&gt;Browser → NGINX → web: HTML, JavaScript, CSS.&lt;br&gt;&lt;br&gt;&lt;b&gt;4b Relative GET /v1/sessions&lt;/b&gt;&lt;br&gt;React → NGINX → API → MongoDB; JSON returns to React.&lt;br&gt;Query: fields (repeatable), status, started_from,&lt;br&gt;started_before, boundary, invoked_by_email, page_size, cursor.&lt;br&gt;Envelope: items, page_size, total_count,&lt;br&gt;next_cursor, previous_cursor.&lt;br&gt;&lt;br&gt;React selects started_at, status,&lt;br&gt;metadata.invoked_by.email, metadata.boundary.&lt;br&gt;It sends applied filters, page_size, and any cursor.&lt;br&gt;Reads rows from page.items; uses response cursors for next/previous.&lt;br&gt;session_id always returns; selected metadata is partial, and runs never appears.&lt;br&gt;&lt;br&gt;&lt;b&gt;Relative GET /v1/sessions/{session_id}&lt;/b&gt;&lt;br&gt;Full metadata + runs, independent of list selection.&lt;br&gt;No field selection, pagination, or hidden run limit.&lt;br&gt;Two reads, not a snapshot.&lt;br&gt;&lt;br&gt;The web server serves assets and internal liveness only.&lt;br&gt;It makes no API or MongoDB calls." vertex="1">
          <mxGeometry height="470" width="490" x="1740" y="1070" as="geometry" />
        </mxCell>
        <mxCell id="q2-caveat" parent="q2-layer" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontFamily=Helvetica;shadow=0;fontColor=#555555;whiteSpace=wrap;" value="Write success responses follow MongoDB acknowledgement. API reads return query results; UI assets come from the web server. A lost POST response may cause a duplicate when the caller retries." vertex="1">
          <mxGeometry height="35" width="2170" x="60" y="1570" as="geometry" />
        </mxCell>
