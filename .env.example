# Placeholders only. Run python3 scripts/init_local_env.py for local credentials.
# Existing MongoDB volumes retain their credentials when this file changes.
MONGO_DB_NAME=quality_agent
MONGO_INITDB_ROOT_USERNAME=replace_root_username
MONGO_INITDB_ROOT_PASSWORD=replace_root_password
MONGO_APP_USERNAME=replace_app_username
MONGO_APP_PASSWORD=replace_app_password
# Percent-encode username/password components when constructing a custom URI.
MONGO_URI=mongodb://replace_app_username:replace_app_password@mongo:27017/quality_agent?authSource=quality_agent
API_BASE_URL=http://api:8000
